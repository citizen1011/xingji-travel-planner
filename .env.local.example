# Local Ollama profile. The OpenAI-compatible adapter accepts this demo credential.
DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=ollama-local
DEEPSEEK_BASE_URL=http://127.0.0.1:11434/v1
DEEPSEEK_MODEL=qwen2.5:7b
TIMEOUT=180
MAX_ITERATIONS=3
RECURSION_LIMIT=40

AMAP_API_KEY=
TAVILY_API_KEY=
ENABLE_LLM_TOOL_CALLING=false
TOOL_RETRY_TIMES=0
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false

API_KEY=travel-planner-secret-2026
DB_PATH=./app/db/travel_agent.db
LOG_DIR=./logs
